msgstr "Не удалось выполнить синхронизацию."

#: usr/share/comm-xfce-datetime/comm-xfce-datetime.py:860
msgid "Synchronization completed successfully!"
msgstr "Синхронизация успешно завершена!"

#: usr/share/comm-xfce-datetime/comm-xfce-datetime.py:862
msgid "Synchronization requested. The clock will be adjusted shortly."
msgstr "Синхронизация запрошена. Часы будут скорректированы в ближайшее время."

