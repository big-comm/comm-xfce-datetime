msgid "Settings applied successfully!"
msgstr "Asetukset otettiin käyttöön!"

#: usr/share/comm-xfce-datetime/comm-xfce-datetime.py:825
msgid ""
"Settings have been applied successfully!\n"
"\n"
"The new timezone is now active for system services and new applications. Some running applications may need to be restarted to use the new timezone settings."
msgstr ""
"Asetukset otettiin käyttöön!\n"
"\n"
"Uusi aikavyöhyke on nyt käytössä järjestelmäpalveluissa ja uusissa sovelluksissa. Jotkin käynnissä olevat sovellukset on ehkä käynnistettävä uudelleen, jotta ne käyttävät uusia aikavyöhykeasetuksia."

#: usr/share/comm-xfce-datetime/comm-xfce-datetime.py:845
msgid "Failed to restart XFCE panel: "
msgstr "XFCE-paneelin uudelleenkäynnistys epäonnistui: "

#: usr/share/comm-xfce-datetime/comm-xfce-datetime.py:851
msgid "Please wait, synchronizing..."
msgstr "Odota, synkronoidaan..."

#: usr/share/comm-xfce-datetime/comm-xfce-datetime.py:871
msgid "Synchronization failed."
msgstr "Synkronointi epäonnistui."

#: usr/share/comm-xfce-datetime/comm-xfce-datetime.py:882
msgid "Synchronization completed successfully!"
msgstr "Synkronointi onnistui!"

#: usr/share/comm-xfce-datetime/comm-xfce-datetime.py:884
msgid "Synchronization requested. The clock will be adjusted shortly."
msgstr "Synkronointia pyydetty. Kello päivitetään pian."

