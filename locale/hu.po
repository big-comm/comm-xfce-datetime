msgstr "Kis türelmet, szinkronizálás folyamatban..."

#: usr/share/comm-xfce-datetime/comm-xfce-datetime.py:849
msgid "Synchronization failed."
msgstr "A szinkronizálás sikertelen."

#: usr/share/comm-xfce-datetime/comm-xfce-datetime.py:860
msgid "Synchronization completed successfully!"
msgstr "A szinkronizálás sikeresen befejeződött!"

#: usr/share/comm-xfce-datetime/comm-xfce-datetime.py:862
msgid "Synchronization requested. The clock will be adjusted shortly."
msgstr "Szinkronizálás kérve. Az óra hamarosan beállításra kerül."

