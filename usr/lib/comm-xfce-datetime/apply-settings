#!/usr/bin/python3
"""Apply date and time settings as root.

Called by comm-xfce-datetime through pkexec, so the user authenticates once for
all the changes instead of once per systemd-timedated action.
"""
import argparse
import math
import os
import subprocess
import sys
import time

NTP_STOP_RETRY_ATTEMPTS = 10
NTP_STOP_RETRY_INTERVAL = 0.5


def timedatectl(*args):
    subprocess.run(["timedatectl", *args], check=True)


def valid_timezone(timezone):
    result = subprocess.run(
        ["timedatectl", "list-timezones", "--no-pager"],
        capture_output=True, text=True, check=True
    )
    return timezone in result.stdout.split()


def set_time(offset):
    """Set the clock to now + offset, retrying while the NTP service stops."""
    for _attempt in range(NTP_STOP_RETRY_ATTEMPTS):
        result = subprocess.run(
            ["timedatectl", "set-time", f"@{time.time() + offset:.6f}"],
            capture_output=True, text=True
        )
        if result.returncode == 0:
            return
        time.sleep(NTP_STOP_RETRY_INTERVAL)
    sys.stderr.write(result.stderr)
    raise subprocess.CalledProcessError(result.returncode, result.args)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--ntp", choices=("true", "false"))
    parser.add_argument("--local-rtc", choices=("true", "false"))
    parser.add_argument("--timezone")
    parser.add_argument("--time-offset", type=float,
                        help="seconds to add to the current time")
    parser.add_argument("--resync", action="store_true",
                        help="restart the NTP service to synchronize now")
    args = parser.parse_args()

    if os.geteuid() != 0:
        parser.error("this helper must be run as root")
    if args.time_offset is not None and not math.isfinite(args.time_offset):
        parser.error("invalid time offset")

    try:
        if args.timezone and not valid_timezone(args.timezone):
            parser.error(f"invalid timezone: {args.timezone}")

        # Disable NTP first, otherwise timedated refuses to set the time
        if args.ntp == "false":
            timedatectl("set-ntp", "false")
        if args.local_rtc:
            timedatectl("set-local-rtc", args.local_rtc)
        if args.timezone:
            timedatectl("set-timezone", args.timezone)
        if args.time_offset is not None:
            set_time(args.time_offset)
        if args.ntp == "true":
            timedatectl("set-ntp", "true")
        if args.resync:
            # timedated restarts the NTP service when it is disabled and enabled again
            timedatectl("set-ntp", "false")
            timedatectl("set-ntp", "true")
    except subprocess.CalledProcessError:
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
